# Dar Chams ignore rules.
# Rule of thumb: regenerable output never enters Git, evidence always does.
# Evidence (committed): docs/, scenarios/*.json, fixtures/, firmware source,
# Wokwi diagram.json, lockfile. See docs/conventions.md section 5.

# Dependencies
node_modules/
.pnp.*
.yarn/cache/
.yarn/unplugged/

# Next.js and build output
.next/
out/
build/
dist/
.turbo/
next-env.d.ts

# TypeScript and lint caches
*.tsbuildinfo
.eslintcache
.cache/

# Tests
coverage/
playwright-report/
test-results/
blob-report/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key

# Simulation and experiment output (reproducible from scenario + seed)
runs/
datasets/
experiments/
artifacts/

# Downloaded model files and bulky source assets
models/downloads/
assets/source/

# PlatformIO and embedded build output
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating system and editor junk
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp
*~
