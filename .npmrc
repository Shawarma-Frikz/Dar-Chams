# Runtime pinning. See docs/runtime-support.md.

# A Node line that does not satisfy package.json engines fails the install
# instead of warning. This is the hard gate behind the .nvmrc pin.
engine-strict=true

# New dependencies are written as exact versions, never ranges.
save-exact=true

# The lockfile is committed and is the only supported install path (npm ci).
package-lock=true

# Optional metadata stays out of the tree.
fund=false
