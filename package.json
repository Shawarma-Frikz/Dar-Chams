{
  "name": "helios",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulation-first residential solar microgrid and energy-management digital twin.",
  "license": "MIT",
  "author": "Shawarma-Frikz",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shawarma-Frikz/Helios.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0 <27",
    "npm": ">=11.15.0 <12"
  },
  "packageManager": "npm@11.15.0",
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:runtime": "node scripts/check-runtime.mjs",
    "check:acceptance": "node scripts/check-acceptance.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "check:requirements": "node scripts/check-requirements.mjs",
    "check:provenance": "node scripts/check-provenance.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:scenarios": "node scripts/validate-scenarios.mjs",
    "check": "npm run check:runtime && npm run check:acceptance && npm run check:decisions && npm run check:requirements && npm run check:provenance && npm run check:config && npm run check:docs && npm run check:ci && npm run check:scenarios",
    "verify": "npm run check && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
