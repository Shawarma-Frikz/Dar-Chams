# Normalise text to LF so the signed checklist digest and every diff are
# portable. Binary artefacts are declared so Git never attempts a conversion.
* text=auto eol=lf

*.md    text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.cpp   text eol=lf
*.h     text eol=lf
*.ino   text eol=lf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.bin   binary
*.elf   binary
*.onnx  binary
