{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Shawarma-Frikz/Dar-Chams/scenarios/scenario.schema.json",
  "title": "Dar Chams scenario",
  "description": "Complete, self-contained description of one virtual installation. Every value that can change a run belongs in a scenario file, never in engine code.",
  "$comment": "Relational invariants that JSON Schema cannot express (min_soc < initial_soc < max_soc, unique appliance IDs, room references, flexibility duration, tariff band order) are enforced by checkScenarioInvariants in packages/engine/src/config/invariants.ts, immediately after this schema validates. Both passes run at application startup, in scripts/validate-scenarios.mjs and in scripts/check-config.mjs. Unknown keys are rejected and reported with the nearest valid name; every numeric property must name its unit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "description",
    "created",
    "provenance",
    "site",
    "mode",
    "simulation",
    "pv",
    "inverter",
    "battery",
    "grid",
    "tariff",
    "weather",
    "household",
    "policies"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/scenarioId" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "created": { "type": "string", "format": "date" },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "notes"],
      "properties": {
        "class": { "enum": ["synthetic-design", "dataset-derived", "measured"] },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "latitude_deg", "longitude_deg", "altitude_m", "timezone"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "latitude_deg": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude_deg": { "type": "number", "minimum": -180, "maximum": 180 },
        "altitude_m": { "type": "number", "minimum": -100, "maximum": 5000 },
        "timezone": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_+/-]*$" }
      }
    },
    "mode": { "enum": ["grid_connected", "off_grid"] },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestep_minutes", "start", "horizon_hours", "seed", "default_speed_multiplier"],
      "properties": {
        "timestep_minutes": { "enum": [5, 15, 30, 60] },
        "start": { "type": "string", "format": "date-time" },
        "horizon_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "seed": { "type": "integer", "minimum": 0 },
        "default_speed_multiplier": { "type": "number", "minimum": 1 }
      }
    },
    "pv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installed_dc_kwp",
        "panel_count",
        "tilt_deg",
        "azimuth_deg",
        "temperature_coefficient_per_degc",
        "noct_degc",
        "soiling_loss",
        "mismatch_loss",
        "availability",
        "shading_windows",
        "tracker"
      ],
      "properties": {
        "installed_dc_kwp": { "type": "number", "exclusiveMinimum": 0 },
        "panel_count": { "type": "integer", "minimum": 1 },
        "tilt_deg": { "type": "number", "minimum": 0, "maximum": 90 },
        "azimuth_deg": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
        "temperature_coefficient_per_degc": { "type": "number", "maximum": 0 },
        "noct_degc": { "type": "number", "minimum": 30, "maximum": 60 },
        "soiling_loss": { "type": "number", "minimum": 0, "maximum": 0.9 },
        "mismatch_loss": { "type": "number", "minimum": 0, "maximum": 0.5 },
        "availability": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "shading_windows": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeWindow" }
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "axes"],
          "properties": {
            "enabled": { "type": "boolean" },
            "axes": { "enum": [0, 1, 2] }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "tracker": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] } },
            "required": ["tracker"]
          },
          "then": { "properties": { "tracker": { "properties": { "axes": { "minimum": 1 } } } } }
        }
      ]
    },
    "inverter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rated_ac_kw", "efficiency", "standby_w", "clipping"],
      "properties": {
        "rated_ac_kw": { "type": "number", "exclusiveMinimum": 0 },
        "efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "standby_w": { "type": "number", "minimum": 0 },
        "clipping": { "type": "boolean" }
      }
    },
    "battery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chemistry",
        "nominal_capacity_kwh",
        "initial_soc",
        "min_soc",
        "max_soc",
        "max_charge_kw",
        "max_discharge_kw",
        "round_trip_efficiency",
        "degradation"
      ],
      "properties": {
        "chemistry": { "enum": ["lfp", "nmc", "lead_acid"] },
        "nominal_capacity_kwh": { "type": "number", "exclusiveMinimum": 0 },
        "initial_soc": { "type": "number", "minimum": 0, "maximum": 1 },
        "min_soc": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_soc": { "type": "number", "minimum": 0, "maximum": 1 },
        "max_charge_kw": { "type": "number", "exclusiveMinimum": 0 },
        "max_discharge_kw": { "type": "number", "exclusiveMinimum": 0 },
        "round_trip_efficiency": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "degradation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "annual_capacity_fade"],
          "properties": {
            "enabled": { "type": "boolean" },
            "annual_capacity_fade": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["import_limit_kw", "export_limit_kw", "outages"],
      "properties": {
        "import_limit_kw": { "type": "number", "minimum": 0 },
        "export_limit_kw": { "type": "number", "minimum": 0 },
        "outages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["start", "end"],
            "properties": {
              "start": { "type": "string", "format": "date-time" },
              "end": { "type": "string", "format": "date-time" }
            }
          }
        }
      }
    },
    "tariff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "verified",
        "source",
        "import_bands",
        "fixed_monthly_tnd",
        "export_compensation_tnd_per_kwh"
      ],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "verified": { "type": "boolean" },
        "source": { "type": "string", "minLength": 1 },
        "import_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["up_to_kwh_per_month", "price_tnd_per_kwh"],
            "properties": {
              "up_to_kwh_per_month": { "type": ["integer", "null"], "minimum": 0 },
              "price_tnd_per_kwh": { "type": ["number", "null"], "minimum": 0 }
            }
          }
        },
        "fixed_monthly_tnd": { "type": ["number", "null"], "minimum": 0 },
        "export_compensation_tnd_per_kwh": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary_source", "historical_source", "cache_dir", "refresh_hours", "fallback_order"],
      "properties": {
        "primary_source": { "enum": ["open-meteo-forecast"] },
        "historical_source": { "enum": ["open-meteo-era5"] },
        "cache_dir": { "type": "string", "minLength": 1 },
        "refresh_hours": { "type": "number", "exclusiveMinimum": 0 },
        "fallback_order": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["cached", "synthetic"] }
        }
      }
    },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preset", "rooms", "appliances"],
      "properties": {
        "preset": { "enum": ["economical", "typical", "high-consumption", "high-flexibility"] },
        "rooms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/room" }
        },
        "appliances": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/appliance" }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "scheduler"],
      "properties": {
        "baseline": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reserve_soc", "shed_order", "hysteresis_soc"],
          "properties": {
            "reserve_soc": { "type": "number", "minimum": 0, "maximum": 1 },
            "shed_order": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["critical", "important", "flexible", "discretionary"] }
            },
            "hysteresis_soc": { "type": "number", "minimum": 0, "maximum": 0.5 }
          }
        },
        "scheduler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reserve_soc", "horizon_hours", "forecast_fallback"],
          "properties": {
            "reserve_soc": { "type": "number", "minimum": 0, "maximum": 1 },
            "horizon_hours": { "type": "integer", "minimum": 1, "maximum": 72 },
            "forecast_fallback": { "enum": ["baseline"] }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "off_grid" } }, "required": ["mode"] },
      "then": {
        "properties": {
          "grid": {
            "properties": {
              "import_limit_kw": { "const": 0 },
              "export_limit_kw": { "const": 0 }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tariff": {
            "properties": { "verified": { "const": true } },
            "required": ["verified"]
          }
        },
        "required": ["tariff"]
      },
      "then": {
        "properties": {
          "tariff": {
            "properties": {
              "import_bands": {
                "items": {
                  "properties": {
                    "price_tnd_per_kwh": { "type": "number", "minimum": 0 }
                  }
                }
              },
              "fixed_monthly_tnd": { "type": "number", "minimum": 0 },
              "export_compensation_tnd_per_kwh": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "clockTime": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timeWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "$ref": "#/$defs/clockTime" },
        "end": { "$ref": "#/$defs/clockTime" }
      }
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "name": { "type": "string", "minLength": 1 },
        "type": { "enum": ["living", "kitchen", "bedroom", "wet", "utility", "outdoor", "other"] }
      }
    },
    "flexibilityWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["earliest", "latest", "duration_minutes", "non_interruptible"],
      "properties": {
        "earliest": { "$ref": "#/$defs/clockTime" },
        "latest": { "$ref": "#/$defs/clockTime" },
        "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
        "non_interruptible": { "type": "boolean" }
      }
    },
    "appliance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "room", "rated_power_w", "priority", "controllable", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/entityId" },
        "name": { "type": "string", "minLength": 1 },
        "room": { "$ref": "#/$defs/entityId" },
        "rated_power_w": { "type": "number", "exclusiveMinimum": 0 },
        "priority": { "enum": ["critical", "important", "flexible", "discretionary"] },
        "controllable": { "type": "boolean" },
        "profile": { "enum": ["always_on", "duty_cycle", "schedule", "flexible_window"] },
        "duty_cycle": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "schedule": { "$ref": "#/$defs/timeWindow" },
        "flexibility": { "$ref": "#/$defs/flexibilityWindow" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "profile": { "const": "always_on" } }, "required": ["profile"] },
          "then": {
            "properties": {
              "duty_cycle": false,
              "schedule": false,
              "flexibility": false
            }
          }
        },
        {
          "if": { "properties": { "profile": { "const": "duty_cycle" } }, "required": ["profile"] },
          "then": {
            "required": ["duty_cycle"],
            "properties": { "schedule": false, "flexibility": false }
          }
        },
        {
          "if": { "properties": { "profile": { "const": "schedule" } }, "required": ["profile"] },
          "then": {
            "required": ["schedule"],
            "properties": { "duty_cycle": false, "flexibility": false }
          }
        },
        {
          "if": { "properties": { "profile": { "const": "flexible_window" } }, "required": ["profile"] },
          "then": {
            "required": ["flexibility"],
            "properties": {
              "duty_cycle": false,
              "schedule": false,
              "controllable": { "const": true }
            }
          }
        }
      ]
    }
  }
}
