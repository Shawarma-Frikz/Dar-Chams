root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Prose is hand-wrapped; trailing spaces are never meaningful here.
trim_trailing_whitespace = false

[*.{c,cpp,h,hpp,ino}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
